{
  "appId": "com.f0uri.aiagent",
  "appName": "AI Agent",
  "webDir": "dist",
  "server": {
    "androidScheme": "https",
    "cleartext": true
  },
  "android": {
    "backgroundColor": "#1a1a1a",
    "allowMixedContent": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "backgroundColor": "#1a1a1a",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    }
  }
}
